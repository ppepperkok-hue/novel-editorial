import sys
sys.path.insert(0, \".\")
from tools import novel_knowledge as nk
from novel_editorial import db

conn = db.connect(\":memory:\")
nk.upsert(conn, 1, \"world_rule\", \"火系规则\", \"火焰规则内容A\")
nk.upsert(conn, 1, \"world_rule\", \"冰系规则\", \"冰系规则内容B\")

# similar entity (火系规则 vs 火系规则改 => ratio high) but different content => conflict draft
d1 = nk.upsert_ex(conn, 1, \"world_rule\", \"火系规则改\", \"完全不同内容C\", check_similar=True)
d2 = nk.upsert_ex(conn, 1, \"world_rule\", \"冰系规则改\", \"完全不同内容D\", check_similar=True)
print(\"d1 similar:\", [(s[\"entity\"], s[\"ratio\"]) for s in d1[\"similar\"]])
print(\"d2 similar:\", [(s[\"entity\"], s[\"ratio\"]) for s in d2[\"similar\"]])
rows = conn.execute(\"SELECT id, title, novel_id, category FROM knowledge_drafts ORDER BY id\").fetchall()
print(\"drafts:\", [tuple(r) for r in rows])
print(\"count:\", len(rows))
