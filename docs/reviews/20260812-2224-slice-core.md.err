113 def get_active_session(conn):
114     """Latest in-progress topic session (running or awaiting input).
115 
116     Stale ``running`` sessions whose heartbeat is older than the heartbeat
117     timeout (default 60 minutes, override via MEETING_HEARTBEAT_TIMEOUT_MINUTES)
118     are considered dead (their background thread died, e.g. after a web_api
119     restart) and are marked failed so they cannot block new meetings.
120     ``awaiting_input`` sessions are left alone: the thread is parked waiting
121     for the user, which is a legitimate state.
122     """
123     row = conn.execute(
124         "SELECT id FROM meeting_sessions WHERE status='running' ORDER BY id DESC LIMIT 5"
125     ).fetchone()
126     if row is not None:
127         session = get_session(conn, row["id"])
128         cutoff = (datetime.now() - timedelta(minutes=_heartbeat_timeout_minutes())).strftime(
129             "%Y-%m-%d %H:%M:%S"
130         )
131         # NULL heartbeat means the row never had one written (e.g. legacy
132         # rows); treat it as alive instead of comparing None to a string.
133         heartbeat = session.get("heartbeat_at") or _now()
134         if heartbeat < cutoff:
135             conn.execute(
136                 "UPDATE meeting_sessions SET status='failed', updated_at=? WHERE id=?",
137                 (_now(), row["id"]),
138             )
139             conn.commit()
140         else:
141             return session
142     parked = conn.execute(
143         "SELECT id FROM meeting_sessions WHERE status='awaiting_input' "
144         "ORDER BY id DESC LIMIT 1"
145     ).fetchone()
146     if parked is not None:
147         return get_session(conn, parked["id"])
148     return None
