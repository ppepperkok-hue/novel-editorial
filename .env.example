# LLM（写作/编辑/审稿/记忆分档）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL_PLANNING=
LLM_MODEL_WRITING=
LLM_MODEL_EDITING=
LLM_MODEL_REVIEWING=
LLM_MODEL_MEMORY=

# DeepSeek（n8n 日更与架构师周会使用）
DEEPSEEK_API_KEY=

# 番茄作者后台登录态（约 1-2 个月失效，失效需重新抓取）
TOMATO_COOKIE=
TOMATO_CSRF_TOKEN=
FANQIE_COOKIE=
FANQIE_CSRF_TOKEN=
# 番茄作品/分卷 ID（n8n 与 tools 脚本从环境变量读取，替换成你自己的）
FANQIE_BOOK_ID=YOUR_FANQIE_BOOK_ID
FANQIE_VOLUME_ID=YOUR_FANQIE_VOLUME_ID
FANQIE_VOLUME_NAME=第一卷：默认

# 月度预算（元），超限触发监控告警
MONTHLY_BUDGET=100

# 编辑部行为开关（import 时读取，改后需重启 web_api）
DISPATCH_MODE=editorial          # editorial | fixed（主编分派）
TASK_RESPONSE_MODE=on            # on | off（写手接受/拒绝/替代方案）
REWORK_MAX=1                     # 每次运行即时重写上限
CLAIM_INJECT=on                  # on | off（认领任务注入写手）
TOPIC_REQUEST_ACTIONS=on         # on | off（议题自动转行动项）
RELATION_WEIGHT=on               # on | off（关系影响分派/措辞）
AGENCY_ENABLED=on                # on | off（安全动作白名单）
MEETING_MODE=rounds              # rounds | open（rounds=全员轮流发言；open=主席点名，失败回退全员）

# 上下文注入量（import 时读取，改后需重启；控制每个 LLM 调用携带的协作上下文）
AGENT_CTX_MESSAGES=8             # 携带的最近消息条数
AGENT_CTX_MEMORIES=3             # 携带的记忆条数
AGENT_CTX_RELATIONS=3            # 携带的关系条数
AGENT_CTX_PROMISES=3             # 携带的承诺条数
AGENT_CTX_ACTIONS=3              # 携带的动作条数
AGENT_CTX_TRUNCATE=200           # 单条内容截断长度（字符）

# 遗留 n8n 回退路径（仅异常回退时使用；tools/n8n_api.py 登录用）
N8N_EMAIL=                       # 登录邮箱（默认空）
N8N_PASSWORD=                    # 登录密码（默认空；当前代码未读取，保留兼容）
N8N_TMP_PW=                      # 登录密码实际取值（默认空；n8n_api.py 使用）

# n8n API key（前端部署/控制工作流用；在 n8n 设置里生成）
N8N_API_KEY=

# n8n API 地址（services/n8n、tools/daily_runs 读取；默认 http://127.0.0.1:5678）
N8N_BASE=http://127.0.0.1:5678

# n8n 工作流 ID（回读执行记录/失败详情用；换成你导入后的实际 ID）
N8N_WORKFLOW_DAILY=SkLUnm3uRyBSY84F
N8N_WORKFLOW_WEEKLY=TAScPjj0Oqtz1uy7
N8N_WORKFLOW_KEEPER=CXz06QvOKNASreBl

# 本机面板鉴权（可选）：配置后非浏览器调用（脚本/n8n）必须带 Bearer 头
PANEL_TOKEN=

# n8n executeCommand 节点运行环境（换成你机器上的实际值，工作流 JSON 不再写死路径）
PYTHON_EXE=C:/path/to/python.exe
PIPELINE_ROOT=C:/path/to/novel-editorial

# 日更题材（设定题材节点读取；留空则用工作流内置默认值）
NOVEL_PREMISE=
NOVEL_KEYWORDS=
NOVEL_GENRE=

# LLM 成本单价（元/千 token），写入 cost_logs 成本台账；本组为唯一生效定义（旧重复项已合并）
COST_PRO_PER_1K=0.01             # pro 模型单价（元/千 token）
COST_FLASH_PER_1K=0.002          # flash 模型单价（元/千 token）

# n8n 服务监听（建议仅本机）
N8N_HOST=127.0.0.1
N8N_LISTEN_ADDRESS=127.0.0.1

# 无头 Chrome 路径（可选；tools/launch_headless_chrome.ps1 使用，不设置则自动探测）
CHROME_EXE=
