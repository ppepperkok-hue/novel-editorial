                conn.close()
        except Exception as exc:  # noqa: BLE001
            _alert(f"继续工作日后台异常: {str(exc)[:300]}")

    _spawn(worker)


def _background_weekly():
    def worker():
        _weekly_worker()

    _spawn(worker)


