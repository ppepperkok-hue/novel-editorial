# Final reproduction: the exact web-API path (check_similar=True), two conflicts in one novel
import sys
sys.path.insert(0, \".\")
from tools import novel_knowledge as nk
from novel_editorial import db

conn = db.connect(\":memory:\")
nk.upsert(conn, 1, \"world_rule\", \"火系规则\", \"火焰规则内容A\")
nk.upsert(conn, 1, \"world_rule\", \"冰系规则\", \"冰系规则内容B\")
a = nk.upsert_ex(conn, 1, \"world_rule\", \"火系规则改\", \"与火系规则冲突的C\", check_similar=True)
b = nk.upsert_ex(conn, 1, \"world_rule\", \"冰系规则改\", \"与冰系规则冲突的D\", check_similar=True)
n = conn.execute(\"SELECT COUNT(*) c FROM knowledge_drafts WHERE kind='knowledge' AND source='auto_conflict' AND status='draft'\").fetchone()[\"c\"]
print(\"conflict-1 similar:\", [s[\"entity\"] for s in a[\"similar\"]])
print(\"conflict-2 similar:\", [s[\"entity\"] for s in b[\"similar\"]])
print(\"expected drafts: 2, actual drafts:\", n)
