                "role, kind, body, mentions, status, created_at) "
                "VALUES(?,?,?,?,?,?,?,?,?,?)",
                (
                    session_id,
                    session["novel_id"],
                    int(seq_row["s"]),
                    agent,
                    "assistant",
                    "speech",
                    parsed["speech"],
                    "[]",
                    "active",
                    now,
                ),

