        \"VALUES('topic','t','running','free',0,?,'[]',datetime('now','localtime'),datetime('now','localtime'),datetime('now','localtime'))\",
        (db_path,),
    )
    conn.commit()
    session_id = cur.lastrowid
    conn.close()

    barrier = threading.Barrier(2)
    errors = []
    seqs = []

    def fake_reply(agent):
        c = db.connect(db_path)
        try:
            seq = c.execute(
                \"SELECT COALESCE(MAX(seq),0)+1 AS s FROM meeting_messages WHERE session_id=?\", (session_id,)
            ).fetchone()[\"s\"]
            seqs.append(seq)
            barrier.wait()
            c.execute(
                \"INSERT INTO meeting_messages(session_id, novel_id, seq, from_agent, role, kind, body, status, created_at) \"
                \"VALUES(?,0,?,?,'assistant','speech',?,'active',datetime('now','localtime'))\",
                (session_id, seq, agent, f\"{agent} de shu\"),
            )
            c.commit()
        except Exception as e:
            errors.append((agent, type(e).__name__))
        finally:
            c.close()

    threads = [threading.Thread(target=fake_reply, args=(a,)) for a in (\"planner\", \"reviewer\")]
    for t in threads: t.start()
    for t in threads: t.join()
    c2 = db.connect(db_path)
    count = c2.execute(\"SELECT COUNT(*) AS c FROM meeting_messages WHERE session_id=?\", (session_id,)).fetchone()[\"c\"]
    c2.close()
    return count, errors, seqs

fails = 0
