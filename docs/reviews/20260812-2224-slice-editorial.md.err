def show(f, pat, before=6, after=10):
    src = open(f, encoding='utf-8').read()
    lines = src.splitlines()
    for i, l in enumerate(lines):
        if pat in l:
            print(f'{f} [{i+1}]')
            for j in range(max(0,i-before), min(len(lines), i+after+1)):
                print(f'  {j+1}: {lines[j]}')
