        except Exception as exc:  # noqa: BLE001
            _alert(f"收工后台异常: {str(exc)[:300]}")

    _spawn(worker)


def _background_resume(run_id, chapters=None):
    def worker():
        try:
            conn = db.connect(_db_path())
            try:
                from tools import workday  # noqa: PLC0415

                workday.resume(
