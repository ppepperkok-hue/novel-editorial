import sys
sys.path.insert(0, \".\")
from tools import novel_knowledge as nk
from tools import clean_novel_knowledge as cnk
from novel_editorial import db

conn = db.connect(\":memory:\")
# keep: light history (v2 current, history v1)
nk.upsert(conn, 1, \"world_rule\", \"灵气划分\", \"k1\")
nk.upsert(conn, 1, \"world_rule\", \"灵气划分\", \"k2\")
# drop: heavy history (v5 current, history v1..v4)
nk.upsert(conn, 1, \"world_rule\", \"灵气划分细则\", \"a1\")
nk.upsert(conn, 1, \"world_rule\", \"灵气划分细则\", \"a2\")
nk.upsert(conn, 1, \"world_rule\", \"灵气划分细则\", \"a3\")
nk.upsert(conn, 1, \"world_rule\", \"灵气划分细则\", \"a4\")
nk.upsert(conn, 1, \"world_rule\", \"灵气划分细则\", \"a5\")
plan = cnk.plan_clean(conn)
keep = plan[\"similar_rules\"][0][\"keep_id\"] if plan[\"similar_rules\"] else None
drop = plan[\"similar_rules\"][0][\"drop_id\"] if plan[\"similar_rules\"] else None
print(\"plan keep/drop:\", keep, drop)
cnk.apply_clean(conn, plan)
cur = conn.execute(\"SELECT id, entity, version, content FROM novel_knowledge\").fetchone()
print(\"current row:\", tuple(cur))
print(\"history:\")
for r in conn.execute(\"SELECT knowledge_id, version, content FROM novel_knowledge_history ORDER BY version\"):
    print(\"  \", tuple(r))
# now a subsequent upsert of the surviving row: does the archive get lost?
kid = cur[\"id\"]
r = nk.upsert(conn, 1, \"world_rule\", cur[\"entity\"], \"new content after merge\")
print(\"upsert id:\", r)
for x in conn.execute(\"SELECT version, content FROM novel_knowledge_history WHERE knowledge_id=? ORDER BY version\", (kid,)):
    print(\"  hist:\", tuple(x))
print(\"current version:\", conn.execute(\"SELECT version FROM novel_knowledge WHERE id=?\", (kid,)).fetchone()[\"version\"])
