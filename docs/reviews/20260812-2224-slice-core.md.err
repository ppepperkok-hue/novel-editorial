got = {}
def raw_client():
    s = socket.create_connection((\"127.0.0.1\", port), timeout=8)
    s.sendall(f\"GET /api/meetings/events?session_id={sid} HTTP/1.1\\r\\nHost: 127.0.0.1:{port}\\r\\nConnection: keep-alive\\r\\n\\r\\n\".encode())
    s.settimeout(8)
    data = b\"\"
    try:
        while b\"\\r\\n\\r\\n\" not in data:
            data += s.recv(4096)
    except Exception as e:
        got[\"hdr_err\"] = repr(e)
    got[\"headers\"] = data[:200].decode(\"utf-8\", \"replace\")
    s.settimeout(8)
    body = b\"\"
    try:
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            body += chunk
            got[\"body\"] = body.decode(\"utf-8\", \"replace\")
            got[\"body_len\"] = len(body)
            break
    except Exception as e:
        got[\"body_err\"] = repr(e)
    s.close()

threading.Thread(target=raw_client, daemon=True).start()
