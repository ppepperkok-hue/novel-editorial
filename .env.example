NOVEL_LLM_API_KEY=
NOVEL_LLM_BASE_URL=https://api.deepseek.com
NOVEL_LLM_MODEL=deepseek-chat
NOVEL_DATA_DIR=./data
NOVEL_LOG_LEVEL=INFO
# 自由意志（N27）：随机度 0–1，0 永远选最高权重候选；默认 0
NOVEL_FREEDOM_DIAL=0.0
# 自由意志随机种子：同 seed 完全复现、换 seed 有变体；默认 42
NOVEL_FREEDOM_SEED=42
# 动机 LLM 提炼开关（N28 占位）：开启仅告警、行为不变；默认 false
NOVEL_MOTIVE_LLM_ENABLED=false
