import sys, json
sys.path.insert(0, \".\")
from tools import novel_knowledge as nk
from tools import clean_novel_knowledge as cnk
from novel_editorial import db

conn = db.connect(\":memory:\")
# chained similar rules: A~B~C (A=B=rule 1 content v3, B v5, C v2)
nk.upsert(conn, 1, \"world_rule\", \"灵气等级划分\", \"灵气等级规则v1\")
nk.upsert(conn, 1, \"world_rule\", \"灵气等级划分标准\", \"灵气等级标准v2\")
nk.upsert(conn, 1, \"world_rule\", \"灵气等级划分细则\", \"灵气等级细则v3\")
# rename candidate: sentence-style entity
nk.upsert(conn, 1, \"world_rule\", \"境界规则：练气筑基金丹\", \"境界内容\")
# duplicate golden finger
nk.upsert(conn, 1, \"power\", \"金手指\", \"power金手指内容\")
nk.upsert(conn, 1, \"item\", \"金手指\", \"item金手指内容\")
# state row
nk.upsert(conn, 1, \"character\", \"沈叙\", \"沈叙状态A\")
nk.upsert(conn, 1, \"character\", \"沈叙·状态\", \"沈叙状态B\")
# misclassified
nk.upsert(conn, 1, \"plot\", \"人物关系\", \"关系内容\")
nk.upsert(conn, 1, \"world_rule\", \"文风\", \"文风内容\")

plan = cnk.plan_clean(conn)
print(json.dumps({k: len(v) for k, v in plan.items()}))
for k, v in plan.items():
    if v:
        print(k, \"->\", v[:3])
try:
    cnk.apply_clean(conn, plan)
    print(\"apply OK\")
except Exception as e:
    print(\"apply FAILED:\", type(e).__name__, e)
rows = conn.execute(\"SELECT id, novel_id, category, entity, content, version FROM novel_knowledge ORDER BY id\").fetchall()
for r in rows:
    print(tuple(r))
