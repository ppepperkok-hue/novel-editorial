{
  "name": "知识管家维护",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 3 * * *"
            }
          ]
        }
      },
      "id": "n-keeper-trigger",
      "name": "每日触发",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "novel-keeper-run",
        "responseMode": "onReceived",
        "options": {}
      },
      "id": "n-keeper-manual",
      "name": "手动触发",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.2,
      "position": [-220, 0],
      "webhookId": "wh-7f1c93b1a4e6d2f0"
    },
    {
      "parameters": {
        "command": "C:/Users/Administrator/AppData/Local/Programs/Python/Python311/python.exe E:/code/novel-pipeline/tools/knowledge_keeper.py --db demo.db",
        "options": {
          "cwd": "E:/code/novel-pipeline"
        }
      },
      "onError": "continueRegularOutput",
      "id": "n-keeper-run",
      "name": "执行维护",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1.2,
      "position": [200, 0]
    },
    {
      "parameters": {
        "jsCode": "return [];"
      },
      "id": "n-keeper-end",
      "name": "结束",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 0]
    }
  ],
  "connections": {
    "每日触发": {
      "main": [
        [
          {
            "node": "执行维护",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "手动触发": {
      "main": [
        [
          {
            "node": "执行维护",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "执行维护": {
      "main": [
        [
          {
            "node": "结束",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
