    "/events": {
      "get": {
        "summary": "Get Global Events",
        "description": "Newest-first events merged across every workspace.\n\nThe global workspaces registry (workspaces table) is the source of\ntruth, matching ``works list`` and ``GET /overview``; no disk scan is\nused. Each workspace stream comes from ``list_events`` in\nrowid-descending order; the merged stream sorts by event time, which\nthe store keeps strictly increasing per process, so it equals\ncross-workspace insertion order (rowid itself is per-database and not\ncomparable). A workspace whose stream cannot be read is warned about\non stderr and counted in ``skipped``; the rest still merge.",
        "operationId": "get_global_events_events_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Get Global Events Events Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
