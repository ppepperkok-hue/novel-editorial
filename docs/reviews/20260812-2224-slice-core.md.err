"""Free-meeting speech executor: assemble context, call the agent, persist.

One agent's reply to a meeting event. The agent decides whether to speak
(`{"speak": false}` means silence); speech is stored in `meeting_messages`
and every failure is explicit (audit + `no_speech`).
"""

from __future__ import annotations

import json
import sqlite3

from novel_editorial.services import audit
from tools import agent_context, agent_meeting, agent_tool_loop
from tools import meeting_interactions

AGENT_PERSONA = {
    "planner": "鏂囩瓥",
    "guard": "瀹堢晫",
    "writer": "澧ㄧ櫧",
    "editor": "娑︾墿",
    "reviewer": "瀹堟",
    "reader": "闃胯",
    "memory": "褰曚簨",
    "work_meta": "涔︽",
    "eic": "鎺屽嵃",
    "ending_judge": "缁堝眬",
    "knowledge_keeper": "鍗氶椈",
}

HISTORY_CHAR_LIMIT = 30000
HISTORY_HEAD_CHARS = 800
HISTORY_TAIL_ROWS = 15


def agent_label(agent: str) -> str:
    """浜烘牸鍚嶏紙涓庡墠绔?AGENT_DEFAULT_NAMES 涓€鑷达級锛岀敤浜庝細璁笂涓嬫枃鏄剧ず銆?""
    return AGENT_PERSONA.get(str(agent or "").replace(".md", ""), str(agent or ""))


def _event_text(event: dict) -> str:
    kind = str(event.get("kind") or "user_message")
    content = str(event.get("content") or "").strip()
    sender = agent_label(event.get("from_agent") or "")
    if kind == "agent_message":
        return f"{sender} 璇达細{content}"
    if kind == "approval_resolved":
        question = str(event.get("question") or "")
        resolution = str(event.get("resolution") or "")
        return f"瀹℃壒缁撴灉锛歿resolution}锛坽question}锛?
    if kind == "cold_timer":
        return (
            "浼氳瀹ゅ畨闈欎簡涓€娈垫椂闂淬€備綘鍙互閫夋嫨鍙戣█鎺ㄨ繘璁ㄨ銆佹彁鍑烘柊璁锛?
            "鎴栦繚鎸佹矇榛樸€?
        )
    return f"鑰佹澘璇达細{content}"


def _history_text(conn, session_id, tail=20):
    rows = conn.execute(
        "SELECT from_agent, body FROM meeting_messages "
        "WHERE session_id=? AND status='active' ORDER BY id DESC LIMIT ?",
        (session_id, tail),
    ).fetchall()
    rows = list(reversed(rows))
    text = "\n".join(f"{agent_label(r['from_agent'])}锛歿r['body']}" for r in rows)
    if len(text) <= HISTORY_CHAR_LIMIT:
        return text
    head = text[:HISTORY_HEAD_CHARS]
    tail_rows = rows[-HISTORY_TAIL_ROWS:]
    tail_text = "\n".join(
        f"{agent_label(r['from_agent'])}锛歿r['body']}" for r in tail_rows
    )
    return head + "\n鈥︼紙涓棿鍙戣█宸插帇缂╋級鈥n" + tail_text


def build_meeting_user(conn, session, agent, event, tail=20):
    """缁勮浼氳鍙戣█杈撳叆锛氫簨浠?+ 鏈€杩戝巻鍙?+ 鍛ㄨ/蹇冩儏 + 鍗忎綔蹇収銆?""
    history_text = _history_text(conn, session["id"], tail=tail) or "锛堣繕娌℃湁鍙戣█锛?
    summary_text = ""
    if session["meeting_summary"]:
        summary_text = f"\n銆愪細璁憳瑕併€憑str(session['meeting_summary'])[:2000]}"

    weekly = agent_meeting.latest_weekly(conn, session["novel_id"], agent)
    weekly_text = ""
    if weekly:
        weekly_text = (
            f"\n鎴戠殑鏈懆鏃ヨ锛歿json.dumps(weekly, ensure_ascii=False)[:600]}"
        )

    snapshot = agent_context.build_context_snapshot(
        conn, agent.replace(".md", ""), session["novel_id"]
    )
    snapshot_text = f"\n{snapshot}" if snapshot else ""

    return (
        f"銆愪細璁€憑session['topic']}\n"
        f"銆愪簨浠躲€憑_event_text(event)}\n"
        f"{summary_text}\n"
        f"銆愭渶杩戝彂瑷€銆慭n{history_text}"
        f"{weekly_text}"
        f"{snapshot_text}\n"
        "璇蜂互浣犵殑鎬ф牸鑷劧鍙戣█銆傝嫢浣犺涓烘鍒讳笉闇€瑕佸紑鍙ｏ紝鍙緭鍑?"
        '{"speak": false}銆傚紑鍙ｅ垯杈撳嚭 JSON锛歿"speech": "浣犵殑鍙戣█"}锛?
        "姝ｅ紡鎻愭鍙墿灞曚负 {\"speech\", \"proposals\", \"priority\"}銆?
    )


