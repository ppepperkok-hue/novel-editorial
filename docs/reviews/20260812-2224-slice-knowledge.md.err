sys.path.insert(0, \".\")
from tools.ai_taste_check import detect

cases = [
    \"\",
    \"普通的一段叙述文字，没有特别的词。\",
    \"天崩地裂，日月无光，山河变色。\",
    \"璀璨的星光！？\",
    \"他缓缓说道：\\\"突然之间，一股强大的气息扑面而来！！\\\"\",
    \"abcdefgh\",  # ASCII 8 chars - should not count (CJK only)
    \"循循善诱循循善诱\",  # 8 CJK chars
    None,
    123,
]
for c in cases:
